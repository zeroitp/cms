@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@ViewData["Title"] - An Homes</title>
    <meta name="description" content="@ViewData["MetaDescription"]" />
    <meta name="keywords" content="@ViewData["MetaKeywords"]" />
    
    <!-- Favicon-->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css" rel="stylesheet" />
    
    <!-- Google fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <!-- Core theme CSS (includes Bootstrap) -->
    <link href="/css/anhome-styles.css" rel="stylesheet" />
    
    <!-- Font Awesome icons -->
    <script src="https://use.fontawesome.com/releases/v6.5.1/js/all.js" crossorigin="anonymous"></script>
</head>
<body>
    <!-- Navigation -->
    @await Html.CachedPartialAsync("~/Views/Partials/anhomeNavigation.cshtml", model: Model, cacheTimeout: TimeSpan.FromMinutes(60))
    
    <!-- Main Content -->
    <main>
        @RenderBody()
    </main>
    
    <!-- Footer -->
    @await Html.CachedPartialAsync("~/Views/Partials/anhomeFooter.cshtml", model: Model, cacheTimeout: TimeSpan.FromMinutes(60))
    
    <!-- Bootstrap core JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    
    <!-- Core theme JS -->
    <script src="/scripts/anhome-scripts.js"></script>
    
    @RenderSection("Scripts", required: false)
</body>
</html>
